<Page
    x:Class="TemplateFiller.Pages.BatchGeneratePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto" Padding="32">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
            <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource SubtleButtonStyle}" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                    <TextBlock Text="Volver"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TemplateNameText" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Generar lote de PDFs" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Contenido -->
        <StackPanel Grid.Row="1" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">

            <!-- Seleccionar Excel -->
            <StackPanel Spacing="8">
                <TextBlock Text="1. Selecciona el Excel con los datos" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" x:Name="ExcelPathBox" PlaceholderText="Ruta del archivo Excel..."
                             IsReadOnly="True"/>
                    <Button Grid.Column="1" x:Name="BrowseExcelButton" Content="Examinar..."
                            Click="BrowseExcelButton_Click"/>
                </Grid>
                <TextBlock x:Name="ExcelInfoText" Text="" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Carpeta de salida -->
            <StackPanel Spacing="8">
                <TextBlock Text="2. Carpeta de destino" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" x:Name="OutputFolderBox" PlaceholderText="Carpeta donde se guardarán los PDFs..."
                             IsReadOnly="True"/>
                    <Button Grid.Column="1" x:Name="BrowseOutputButton" Content="Examinar..."
                            Click="BrowseOutputButton_Click"/>
                </Grid>
            </StackPanel>

            <!-- Patrón de nombre de archivo -->
            <StackPanel Spacing="8">
                <TextBlock Text="3. Nombre de archivo (opcional)" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBox x:Name="FilePatternBox" Text="documento_{row}"
                         Header="Usa {row} para el número de fila"/>
                <TextBlock Text="Ejemplo: contrato_{row} → contrato_1.pdf, contrato_2.pdf..."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Progreso -->
            <ProgressBar x:Name="GenerateProgress" Visibility="Collapsed" IsIndeterminate="False"/>
            <TextBlock x:Name="ProgressText" Text="" Style="{StaticResource CaptionTextBlockStyle}"/>

        </StackPanel>

        <!-- Botón generar -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Button x:Name="GenerateButton" Content="⚡ Generar PDFs"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="GenerateButton_Click" IsEnabled="False"
                    HorizontalAlignment="Left" Padding="24,10"/>
        </Grid>

    </Grid>
</Page>
